<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>ClassicUs.ManuAPI.ModExample</AssemblyName>
    <RootNamespace>ClassicUs.ManuAPI.ModExample</RootNamespace>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>disable</Nullable>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <NoWarn>CS0626;CS0649;CS8632;CS0108</NoWarn>
    <GameDir>C:\Users\afino\Downloads\Classic.Us.2026.7.4.Windows\Classic Us 2026.7.11 Windows</GameDir>
    <PluginsDir>$(GameDir)\BepInEx\plugins</PluginsDir>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ClassicUs.GameLibs" Version="2026.7.11.1" PrivateAssets="all" />
    <ProjectReference Include="..\Manactor\Manactor\Manactor.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\ManuAPI\ManuAPI\ManuAPI.csproj" PrivateAssets="all" />
  </ItemGroup>
  <Target Name="CopyToPlugins" AfterTargets="Build">
    <MakeDir Directories="$(PluginsDir)" />
    <Copy SourceFiles="$(OutputPath)$(AssemblyName).dll" DestinationFolder="$(PluginsDir)" />
    <Message Importance="high" Text="Copied $(AssemblyName).dll -> $(PluginsDir)" />
  </Target>
</Project>
